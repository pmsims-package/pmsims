> flush(stderr()); flush(stdout())
> 
> base::assign(".ptime", proc.time(), pos = "CheckExEnv")
> ### Name: simulate_custom
> ### Title: Minimum sample size for custom simulation workflows
> ### Aliases: simulate_custom
> 
> ### ** Examples
> 
> ## Not run: 
> ##D data_fun <- function(n) {
> ##D   x1 <- rnorm(n)
> ##D   x2 <- rnorm(n)
> ##D   y <- 0.5 * x1 - 0.25 * x2 + rnorm(n, sd = 1)
> ##D   data.frame(y = y, x1 = x1, x2 = x2)
> ##D }
> ##D 
> ##D model_fun <- function(dat) {
> ##D   stats::lm(y ~ ., data = dat)
> ##D }
> ##D 
> ##D metric_fun <- function(test_data, fit, model) {
> ##D   preds <- stats::predict(fit, newdata = test_data)
> ##D   1 - sum((test_data$y - preds)^2) /
> ##D     sum((test_data$y - mean(test_data$y))^2)
> ##D }
> ##D attr(metric_fun, "metric") <- "r2"
> ##D attr(metric_fun, "value_on_error") <- 0
> ##D 
> ##D maximum_achievable_data <- data_fun(10000)
> ##D test_data <- data_fun(5000)
> ##D maximum_achievable_fit <- model_fun(maximum_achievable_data)
> ##D maximum_achievable_performance <- metric_fun(
> ##D   test_data,
> ##D   maximum_achievable_fit,
> ##D   "lm"
> ##D )
> ##D 
> ##D est <- simulate_custom(
> ##D   data_function = data_fun,
> ##D   model_function = model_fun,
> ##D   metric_function = metric_fun,
> ##D   target_performance = maximum_achievable_performance - 0.05,
> ##D   test_n = 5000,
> ##D   n_reps_total = 80,
> ##D   n_reps_per = 10,
> ##D   method = "bisection"
> ##D )
> ##D est
> ## End(Not run)
> 
> 
> 
> base::assign(".dptime", (proc.time() - get(".ptime", pos = "CheckExEnv")), pos = "CheckExEnv")
> base::cat("simulate_custom", base::get(".format_ptime", pos = 'CheckExEnv')(get(".dptime", pos = "CheckExEnv")), "\n", file=base::get(".ExTimings", pos = 'CheckExEnv'), append=TRUE, sep="\t")
